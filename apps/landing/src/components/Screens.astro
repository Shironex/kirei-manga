---
import { Picture } from 'astro:assets';
// Real captures from the app's demo mode (`pnpm shots` at the repo root), kept
// in the repo's assets/screenshots and shared with the README.
import library from '../../../../assets/screenshots/library.webp';
import series from '../../../../assets/screenshots/series.webp';
import single from '../../../../assets/screenshots/reader-single.webp';
import webtoon from '../../../../assets/screenshots/reader-webtoon.webp';
import browse from '../../../../assets/screenshots/browse.webp';
import palette from '../../../../assets/screenshots/command-palette.webp';
import stats from '../../../../assets/screenshots/stats.webp';

const SHOTS = [
  { src: library, alt: 'The library: the series to continue reading, big, with the others in progress beside it, Want to Read and a pinned smart filter below.', caption: 'Library, tinted by the series you would resume.', size: 'wide' },
  { src: series, alt: 'A series page with its cover, synopsis, chapter list, tags, collections and AniList progress.', caption: 'Series page, with your tags, collections and AniList.', size: 'half' },
  { src: single, alt: 'The reader on a single black and white manga page, read right to left.', caption: 'Single page reader, right to left.', size: 'half' },
  { src: webtoon, alt: 'The reader in webtoon mode, one continuous vertical strip of colour panels.', caption: 'Webtoon mode, one continuous strip.', size: 'half' },
  { src: browse, alt: 'Browsing MangaDex in a grid of covers, with the preferred reading languages above.', caption: 'Browse MangaDex in your languages.', size: 'half' },
  { src: palette, alt: 'The command palette over the library, matching a series and settings as you type.', caption: 'One shortcut to any series, chapter or setting.', size: 'half' },
  { src: stats, alt: 'Reading stats: hours read this year, a streak, and a heatmap of every day of the year.', caption: 'Reading stats that stay on your computer.', size: 'half' },
] as const;
---

<section id="screens" class="section screens" aria-labelledby="screens-title">
  <div class="wrap">
    <div class="head reveal">
      <p class="eyebrow">Screens</p>
      <h2 class="section-title" id="screens-title">A quiet frame for loud covers.</h2>
      <p class="section-lede">
        The interface stays dark and still, so the art carries the colour. Every screen here is the
        app itself, running on a made up demo library.
      </p>
    </div>
    <div class="gallery">
      {
        SHOTS.map(shot => (
          <figure class:list={['shot', 'reveal', shot.size]}>
            <Picture
              src={shot.src}
              alt={shot.alt}
              formats={['avif', 'webp']}
              fallbackFormat="webp"
              widths={shot.size === 'wide' ? [720, 1200, 1440] : [480, 720, 960]}
              sizes={
                shot.size === 'wide'
                  ? '(min-width: 1320px) 1240px, 92vw'
                  : '(min-width: 1320px) 612px, (min-width: 760px) calc(50vw - 40px), calc(100vw - 32px)'
              }
              loading="lazy"
              decoding="async"
            />
            <figcaption>{shot.caption}</figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .head {
    margin-bottom: clamp(40px, 6vw, 72px);
  }
  .gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(16px, 2.4vw, 28px);
  }
  .shot {
    margin: 0;
  }
  .shot.wide {
    grid-column: 1 / -1;
  }
  .shot :global(img) {
    width: 100%;
    height: auto;
    border-radius: var(--r-panel);
    border: 1px solid var(--line);
    box-shadow:
      0 40px 90px -40px oklch(0.04 0.02 var(--seed-h) / 0.9),
      0 0 0 1px oklch(0 0 0 / 0.4);
    background: var(--ink-1);
  }
  figcaption {
    margin-top: var(--s-3);
    font-size: var(--t-sm);
    color: var(--fg-3);
  }
  @media (max-width: 759px) {
    .gallery {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
