{
  "name": "kireimanga",
  "version": "0.3.0",
  "private": true,
  "description": "KireiManga, a desktop manga reader built on Tauri and Rust",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "dev": "pnpm --filter @kireimanga/desktop tauri dev",
    "dev:web": "pnpm --filter @kireimanga/desktop dev",
    "tauri": "pnpm --filter @kireimanga/desktop tauri",
    "build": "pnpm --filter @kireimanga/desktop build",
    "dev:landing": "pnpm --filter @kireimanga/landing dev",
    "build:landing": "pnpm --filter @kireimanga/landing build",
    "posters:landing": "pnpm --filter @kireimanga/landing posters",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "notices": "node scripts/notices.mjs",
    "prepare": "husky",
    "typecheck": "pnpm --filter @kireimanga/desktop typecheck"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.16.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ],
    "*.rs": [
      "rustfmt --edition 2024"
    ]
  }
}
