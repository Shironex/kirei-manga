{
  "name": "kireimanga",
  "version": "0.3.0",
  "private": true,
  "description": "KireiManga, a desktop manga reader built on Tauri and Rust",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "dev:landing": "pnpm --filter @kireimanga/landing dev",
    "build:landing": "pnpm --filter @kireimanga/landing build",
    "og:landing": "pnpm --filter @kireimanga/landing og",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.4.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0"
  }
}
