# business to skip rather than git's.

# Cargo build output and Tauri's regenerated permission schemas.
target/
apps/desktop/src-tauri/gen/

# Package managers own their lockfiles' formatting.
Cargo.lock
pnpm-lock.yaml

# Design prototype sources, kept exactly as approved.
docs/design/*.html
docs/design/tokens.css

# docs/ is written by the spec workflow and is not reformatted here.
docs/

